# Copy to .env and fill in. .env is gitignored; .env.example is committed.

# Kaggle — used by `kaggle datasets download` to fetch the raw PdM CSVs.
KAGGLE_API_TOKEN=

# Weights & Biases — used by src/tune.py for hyperparameter search tracking.
# Get your key at https://wandb.ai/authorize. Entity is your W&B username or team.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=quadsci-predictive-maintenance
# Optional: set to "offline" to log to ./wandb without uploading, "disabled" to no-op.
WANDB_MODE=online
